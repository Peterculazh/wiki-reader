{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/ingester/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/ingester/tsconfig.app.json"
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "archiver": {
      "type": "application",
      "root": "apps/archiver",
      "entryFile": "main",
      "sourceRoot": "apps/archiver/src",
      "compilerOptions": {
        "tsConfigPath": "apps/archiver/tsconfig.app.json"
      }
    },
    "bursts": {
      "type": "application",
      "root": "apps/bursts",
      "entryFile": "main",
      "sourceRoot": "apps/bursts/src",
      "compilerOptions": {
        "tsConfigPath": "apps/bursts/tsconfig.app.json"
      }
    },
    "ingester": {
      "type": "application",
      "root": "apps/ingester",
      "entryFile": "main",
      "sourceRoot": "apps/ingester/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ingester/tsconfig.app.json"
      }
    },
    "kafka": {
      "type": "library",
      "root": "libs/kafka",
      "entryFile": "index",
      "sourceRoot": "libs/kafka/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kafka/tsconfig.lib.json"
      }
    },
    "health": {
      "type": "library",
      "root": "libs/health",
      "entryFile": "index",
      "sourceRoot": "libs/health/src",
      "compilerOptions": {
        "tsConfigPath": "libs/health/tsconfig.lib.json"
      }
    },
    "storage": {
      "type": "library",
      "root": "libs/storage",
      "entryFile": "index",
      "sourceRoot": "libs/storage/src",
      "compilerOptions": {
        "tsConfigPath": "libs/storage/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    }
  },
  "monorepo": true,
  "root": "apps/ingester"
}