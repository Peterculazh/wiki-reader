# Copy to .env.local (git-ignored) for `npm run dev`.

# Server side only: React Server Components fetch the first snapshot from here.
# Read when a request is rendered, so in Kubernetes it comes from the ConfigMap.
API_URL=http://localhost:3004

# Browser side: the EventSource for GET /live connects here. Next inlines
# NEXT_PUBLIC_ variables into the JavaScript bundle at build time, so the Docker
# image keeps the value it was built with (see Dockerfile).
NEXT_PUBLIC_API_URL=http://localhost:3004
