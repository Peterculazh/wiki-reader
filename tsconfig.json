{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/kafka": [
        "./libs/kafka/src/index.ts"
      ],
      "@app/kafka/testing": [
        "./libs/kafka/src/testing/index.ts"
      ],
      "@app/kafka/*": [
        "./libs/kafka/src/*"
      ],
      "@app/storage": [
        "./libs/storage/src/index.ts"
      ],
      "@app/storage/testing": [
        "./libs/storage/src/testing/index.ts"
      ],
      "@app/storage/*": [
        "./libs/storage/src/*"
      ],
      "@app/health": [
        "./libs/health/src/index.ts"
      ],
      "@app/health/*": [
        "./libs/health/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/ingester/tsconfig.app.json"
    },
    {
      "path": "./apps/archiver/tsconfig.app.json"
    },
    {
      "path": "./apps/bursts/tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}